+                continue;
+            }
+            let case = format!("C07-{short}-invalid-example-{i:02}-refused");
+            let (req, resp, audit) = f
+                .send(&case, PRODUCER_SEED, &auth, task, ex["payload"].clone())
+                .await;
+            summary.push(serde_json::json!({
+                "task": short, "index": i, "variant": "request", "note": note,
+                "responseType": resp["type"], "code": code(&resp),
+                "signed": !audit.is_empty(),
+            }));
+            assert!(is_error(&resp), "{case} accepted: {note}\n{resp:#}");
+            assert!(audit.is_empty(), "{case}: signed");
+            assert!(
+                resp.pointer("/payload/jws").is_none() && resp.pointer("/payload/csr").is_none()
+            );
+            let _ = req;
+        }
+    }
+    evidence(
+        "C07-invalid-examples-summary",
+        &Value::Null,
+        &Value::Array(summary),
+        &[],
+    );
+}

+/// Conformance item 4: an Ed25519 key signs `EdDSA`; `payloadBase64Url` is
+/// carried unchanged as the payload segment.
+#[tokio::test]
+async fn sign_jws_ed25519_and_payload_base64url() {
+    let f = Fixture::new().await;
+    let auth = f
+        .producer(PRODUCER_SEED, Role::Application, vec![Capability::SignJws])
+        .await;
+    let (_, resp, audit) = f
+        .send(
+            "sign-jws-ed25519-payloadBase64Url-accepted",
+            PRODUCER_SEED,
+            &auth,
+            JWS,
+            serde_json::json!({
+                "keyId": "verifier-ed25519",
+                "header": { "typ": "example+jwt" },
+                "payloadBase64Url": "aGVsbG8"
+            }),
+        )
+        .await;
+    assert_eq!(resp["type"], format!("{JWS}#response"), "{resp:#}");
+    assert_eq!(resp["payload"]["alg"], "EdDSA");
+    let jws = resp["payload"]["jws"].as_str().unwrap();
+    assert_eq!(jws.split('.').nth(1), Some("aGVsbG8"));
+    let key = f.public("verifier-ed25519").await;
+    let (input, sig) = jws.rsplit_once('.').unwrap();
+    key.verify_signature(input.as_bytes(), &URL_SAFE_NO_PAD.decode(sig).unwrap())
+        .expect("EdDSA over the signing input");
+    assert_eq!(audit.len(), 1);
+}

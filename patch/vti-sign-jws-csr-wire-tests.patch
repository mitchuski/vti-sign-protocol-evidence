+  {
+    "note": "A raw DER CertificationRequestInfo to sign — the generic oracle's shape. additionalProperties: false is what keeps the custodian building the request itself.",
+    "payload": {
+      "keyId": "eudi-access-p256",
+      "subject": [{ "type": "CN", "value": "Example Community Verifier" }],
+      "certificationRequestInfo": "MIIBNgIBADB4MQswCQYDVQQGEwJERQ"
+    }
+  },
+  {
+    "note": "A requested extension — extensions come from the CA, and only the subject alternative name is ever requested.",
+    "payload": {
+      "keyId": "eudi-access-p256",
+      "subject": [{ "type": "CN", "value": "Example Community Verifier" }],
+      "extensions": [{ "oid": "2.5.29.19", "critical": true, "value": "MAMBAf8" }]
+    }
+  },
+  {
+    "note": "A wildcard dNSName — this task requests exact host names only.",
+    "payload": {
+      "keyId": "eudi-access-p256",
+      "subject": [{ "type": "CN", "value": "Example Community Verifier" }],
+      "subjectAltNames": { "dns": ["*.community.example"] }
+    }
+  },
+  {
+    "note": "An unknown subjectAltNames kind (`ip`) — the set of kinds is closed.",

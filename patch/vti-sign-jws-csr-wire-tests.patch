+const SPEC_CSR: &str = "-----BEGIN CERTIFICATE REQUEST-----\nMIIBjzCCATYCAQAweDELMAkGA1UEBhMCREUxHzAdBgNVBAoMFkV4YW1wbGUgQ29t\nbXVuaXR5IGUuVi4xIzAhBgNVBGEMGkxFSVhHLTUyOTkwMDBFWEFNUExFMDAwMDAx\nMSMwIQYDVQQDDBpFeGFtcGxlIENvbW11bml0eSBWZXJpZmllcjBZMBMGByqGSM49\nAgEGCCqGSM49AwEHA0IABPeQCDiwlBbsbMalmpZyIBiXUMwKLUsPdS9cdMUqT5BK\n82pnE50hQM83H375pOf/nBtaNQboR0m18jFARbmBbD+gXDBaBgkqhkiG9w0BCQ4x\nTTBLMEkGA1UdEQRCMECCGnZlcmlmaWVyLmNvbW11bml0eS5leGFtcGxlhiJodHRw\nczovL3ZlcmlmaWVyLmNvbW11bml0eS5leGFtcGxlMAoGCCqGSM49BAMCA0cAMEQC\nIEiJ000jPd1gG5qAM+WaNYAc+RpApmiSAn7Mvw+i3ODfAiBwV/5C5DQzAAmXbxxr\nFmoRrcONsMPAjGP1XarGPxBspA==\n-----END CERTIFICATE REQUEST-----\n";
+const SPEC_CSR_KEY: &str = "did:key:zDnaezKfW1F36Bc3ranfFMiPJXexoqUeHSYLeQwGns4npGdh3";
+
+/// The DER of `der`'s first inner element: for a `CertificationRequest`, its
+/// `CertificationRequestInfo`.
+fn first_inner_element(der: &[u8]) -> &[u8] {
+    fn header(b: &[u8]) -> (usize, usize) {
+        // (header length, content length) of the TLV at the start of `b`.
+        match b[1] {
+            n if n < 0x80 => (2, n as usize),
+            0x81 => (3, b[2] as usize),
+            0x82 => (4, ((b[2] as usize) << 8) | b[3] as usize),
+            other => panic!("unsupported DER length form {other:#x}"),
+        }
+    }
+    let (outer, _) = header(der);
+    let inner = &der[outer..];
+    let (h, len) = header(inner);
+    &inner[..h + len]
+}
+
+fn pem_der(pem: &str) -> Vec<u8> {
+    let body: String = pem.lines().filter(|l| !l.starts_with("-----")).collect();
+    STANDARD.decode(body).expect("PEM base64")
+}

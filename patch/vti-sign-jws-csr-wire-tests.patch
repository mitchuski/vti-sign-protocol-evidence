+/// The `CertificationRequestInfo` the VTA builds from the specification's
+/// request and the specification's key is byte-for-byte the one in the
+/// specification's example CSR, whose signature verifies over it.
+#[test]
+fn sign_csr_spec_example_info_is_reproduced() {
+    use crate::operations::sign_formats::{CsrKey, certification_request_info};
+    use vta_sdk::protocols::key_management::sign_csr::SignCsrPayload;
+    let req: SignCsrPayload = serde_json::from_value(spec_csr_request()).unwrap();
+    let key = JwsKey::from_did_key(SPEC_CSR_KEY).unwrap();
+    let built = certification_request_info(
+        &req.subject,
+        req.subject_alt_names.as_ref(),
+        &CsrKey::from_jws_key(&key).unwrap(),
+    );
+    let der = pem_der(SPEC_CSR);
+    assert_eq!(built.as_slice(), first_inner_element(&der));
+
+    // The spec signature (DER Ecdsa-Sig-Value at the end) verifies over it.
+    let sig_der = {
+        let tail = &der[der.len() - 0x49..];
+        assert_eq!(tail[0], 0x03, "BIT STRING");
+        &tail[3..]
+    };
+    let sig = p256::ecdsa::Signature::from_der(sig_der).expect("DER signature");
+    key.verify_signature(&built, &sig.to_bytes())
+        .expect("the spec's CSR signature verifies over the rebuilt info");
+}

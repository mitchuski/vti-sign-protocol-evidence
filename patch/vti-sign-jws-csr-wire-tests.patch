+/// rejected by the response schema the VTA answers against.
+#[tokio::test]
+async fn the_specifications_invalid_examples_are_refused_by_the_vta() {
+    let f = Fixture::new().await;
+    let auth = f
+        .producer(
+            PRODUCER_SEED,
+            Role::Application,
+            vec![Capability::SignJws, Capability::SignCsr],
+        )
+        .await;
+    let mut summary = Vec::new();
+    for (task, file, short) in [
+        (
+            JWS,
+            include_str!("sign_protocol_fixtures/sign-jws-0.1.payload.invalid-examples.json"),
+            "sign-jws",
+        ),
+        (
+            CSR,
+            include_str!("sign_protocol_fixtures/sign-csr-0.1.payload.invalid-examples.json"),
+            "sign-csr",
+        ),
+    ] {
+        let examples: Vec<Value> = serde_json::from_str(file).unwrap();
+        for (i, ex) in examples.iter().enumerate() {
+            let note = ex["note"].as_str().unwrap_or_default();
+            if ex["variant"] == "response" {
+                let rejected = match short {
+                    "sign-jws" => {
+                        trust_tasks_rs::specs::keys::sign_jws::v0_1::Response::validate_value(
+                            &ex["payload"],
+                        )
+                        .is_err()

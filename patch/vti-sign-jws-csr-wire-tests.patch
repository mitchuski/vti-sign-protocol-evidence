+// ── keys/sign-jws/0.1 ────────────────────────────────────────────────────
+
+/// The specification's own example JWS verifies under the key it names, and
+/// its signing input has the digest the audit line is said to record.
+#[test]
+fn sign_jws_spec_example_verifies() {
+    let key = JwsKey::from_did_key(SPEC_JWS_KEY).unwrap();
+    key.verify_compact(SPEC_JWS)
+        .expect("the spec's JWS verifies");
+    let input = SPEC_JWS.rsplit_once('.').unwrap().0;
+    assert_eq!(
+        hex::encode(Sha256::digest(input.as_bytes())),
+        SPEC_JWS_DIGEST
+    );
+}
+
+/// C01 / Conformance items 4, 7, 8 and Audit: the specification's request,
+/// sent to the VTA, comes back as the `#response` variant; `alg` is ES256 from
+/// the key; the header and payload segments are byte-for-byte the
+/// specification's (RFC 8785); the JWS verifies under the VTA-held key; the
+/// response validates against the response schema; and the one audit row is
+/// `keys.sign-jws` with `alg`, `typ` and the signing-input digest — never the
+/// payload.
+#[tokio::test]
+async fn sign_jws_spec_request_is_answered_with_a_verifiable_jws() {
+    let f = Fixture::new().await;
+    let auth = f
+        .producer(PRODUCER_SEED, Role::Application, vec![Capability::SignJws])
+        .await;
+    let (req, resp, audit) = f
+        .send(
+            "C01-sign-jws-accepted",
+            PRODUCER_SEED,
+            &auth,
+            JWS,
+            spec_jws_request(),
+        )
+        .await;
+    assert_eq!(resp["type"], format!("{JWS}#response"), "{resp:#}");
+    assert_eq!(resp["threadId"], req["id"]);
+    assert!(resp["proof"].is_object(), "the answer is signed: {resp:#}");
+    let p = &resp["payload"];
+    assert_eq!(p["keyId"], JWS_KEY);
+    assert_eq!(p["alg"], "ES256");
+    trust_tasks_rs::specs::keys::sign_jws::v0_1::Response::validate_value(p)
+        .expect("the response validates against its schema");
+
+    let jws = p["jws"].as_str().unwrap();
+    let (input, _sig) = jws.rsplit_once('.').unwrap();
+    assert_eq!(
+        input,
+        SPEC_JWS.rsplit_once('.').unwrap().0,
+        "header and payload segments are the specification's"
+    );
+    assert_eq!(
+        hex::encode(Sha256::digest(input.as_bytes())),
+        SPEC_JWS_DIGEST
+    );
+    let claims = f
+        .public(JWS_KEY)
+        .await
+        .verify_compact(jws)
+        .expect("verifies");
+    assert_eq!(claims["nonce"], "q8vTt3yN5mQ0aW2f");
+    assert!(
+        JwsKey::from_did_key(SPEC_JWS_KEY)
+            .unwrap()
+            .verify_compact(jws)
+            .is_err(),
+        "and under no other key"
+    );
+
+    assert_eq!(audit.len(), 1, "{audit:?}");
+    assert_eq!(audit[0].action, "keys.sign-jws");
+    assert_eq!(audit[0].resource.as_deref(), Some(JWS_KEY));
+    let detail = audit[0].detail.as_deref().unwrap_or_default();
+    assert_eq!(
+        detail,
+        format!("alg=ES256 typ=oauth-authz-req+jwt sha256={SPEC_JWS_DIGEST}")
+    );
+    assert!(
+        !detail.contains("q8vTt3yN5mQ0aW2f"),
+        "no payload in the audit"
+    );
+}

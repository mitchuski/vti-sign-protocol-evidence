+/// C02 / Conformance item 5: every forbidden header member is refused with
+/// `keys/sign-jws:headerMemberForbidden` naming it in `details.member` — a
+/// `trust-task-error`, never a `#response`, and nothing signed.
+#[tokio::test]
+async fn sign_jws_forbidden_header_members_are_refused_on_the_wire() {
+    let f = Fixture::new().await;
+    let auth = f
+        .producer(PRODUCER_SEED, Role::Application, vec![Capability::SignJws])
+        .await;
+    for (member, value) in [
+        ("alg", serde_json::json!("none")),
+        ("crit", serde_json::json!(["exp"])),
+        ("b64", serde_json::json!(false)),
+        (
+            "jwk",
+            serde_json::json!({ "kty": "EC", "crv": "P-256", "x": "AA", "y": "AA" }),
+        ),
+        (
+            "jku",
+            serde_json::json!("https://attacker.example/jwks.json"),
+        ),
+        (
+            "x5u",
+            serde_json::json!("https://attacker.example/chain.pem"),
+        ),
+    ] {
+        let mut payload = spec_jws_request();
+        payload["header"][member] = value;
+        let case = format!("C02-sign-jws-header-{member}-refused");
+        let (req, resp, audit) = f.send(&case, PRODUCER_SEED, &auth, JWS, payload).await;
+        assert_refused(
+            &case,
+            &req,
+            &resp,
+            &audit,
+            "keys/sign-jws:headerMemberForbidden",
+        );
+        assert_eq!(resp["payload"]["details"]["member"], member, "{resp:#}");
+        assert_eq!(resp["payload"]["retryable"], false, "{resp:#}");
+    }
+}

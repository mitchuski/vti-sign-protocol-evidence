+/// C05 / Conformance items 6 and 7: the specification's request comes back as
+/// the `#response` variant with a PEM CSR in 64-character LF lines, the key's
+/// own `publicKey`, the specification's subject and alternative names, the
+/// key's own SPKI, a signature that verifies, and exactly the info the
+/// specification fixes; one `keys.sign-csr` audit row with subject, names and
+/// the digest of the signed DER.
+#[tokio::test]
+async fn sign_csr_spec_request_is_answered_with_a_verifiable_request() {
+    use crate::operations::sign_formats::{CsrKey, certification_request_info};
+    use vta_sdk::protocols::key_management::sign_csr::SignCsrPayload;
+    use x509_parser::prelude::*;
+    let f = Fixture::new().await;
+    let auth = f
+        .producer(PRODUCER_SEED, Role::Application, vec![Capability::SignCsr])
+        .await;
+    let (req, resp, audit) = f
+        .send(
+            "C05-sign-csr-accepted",
+            PRODUCER_SEED,
+            &auth,
+            CSR,
+            spec_csr_request(),
+        )
+        .await;
+    assert_eq!(resp["type"], format!("{CSR}#response"), "{resp:#}");
+    assert_eq!(resp["threadId"], req["id"]);
+    let p = &resp["payload"];
+    trust_tasks_rs::specs::keys::sign_csr::v0_1::Response::validate_value(p)
+        .expect("the response validates against its schema");
+    let record = f.record(CSR_KEY).await;
+    assert_eq!(p["publicKey"], record.public_key);
+    let pem = p["csr"].as_str().unwrap();
+    assert!(pem.starts_with("-----BEGIN CERTIFICATE REQUEST-----\n"));
+    assert!(pem.ends_with("-----END CERTIFICATE REQUEST-----\n"));
+    assert!(!pem.contains('\r') && pem.lines().all(|l| l.len() <= 64));
+
+    let der = pem_der(pem);
+    let (rest, csr) = X509CertificationRequest::from_der(&der).unwrap();
+    assert!(rest.is_empty());
+    csr.verify_signature()
+        .expect("the request's signature verifies");
+    let parsed: SignCsrPayload = serde_json::from_value(spec_csr_request()).unwrap();
+    let own = CsrKey::from_jws_key(&f.public(CSR_KEY).await).unwrap();
+    let expected =
+        certification_request_info(&parsed.subject, parsed.subject_alt_names.as_ref(), &own);
+    assert_eq!(first_inner_element(&der), expected.as_slice());
+    let exts: Vec<_> = csr.requested_extensions().unwrap().collect();
+    assert_eq!(exts.len(), 1, "subjectAltName alone");
+
+    assert_eq!(audit.len(), 1, "{audit:?}");
+    assert_eq!(audit[0].action, "keys.sign-csr");
+    assert_eq!(
+        audit[0].detail.as_deref(),
+        Some(
+            format!(
+                "subject=C=DE,O=Example Community e.V.,organizationIdentifier=LEIXG-5299000EXAMPLE000001,CN=Example Community Verifier san=dns:verifier.community.example,uri:https://verifier.community.example sha256={}",
+                hex::encode(Sha256::digest(&expected))
+            )
+            .as_str()
+        )
+    );
+}

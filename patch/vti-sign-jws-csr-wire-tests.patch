+//! `keys/sign-jws/0.1` and `keys/sign-csr/0.1` through the dispatch spine: a
+//! signed Trust Task document in, the VTA's signed answer out, each case
+//! asserted by what reaches the wire — the `#response` variant for an accepted
+//! request, a `trust-task-error` carrying the declared code (and no JWS or CSR)
+//! for a refused one — and by the audit rows the attempt left.
+//!
+//! The operation-level tests in `operations::keys` hold the same rules one layer
+//! down; these hold the wire contract the specifications state.
+//!
+//! When `VTI_EVIDENCE_DIR` is set, every exchange is also written there as
+//! `<case>.request.json`, `<case>.response.json` and `<case>.audit.json`, so a
+//! run can be kept as a reviewable trace. Unset, nothing is written.
+
+use super::*;
+use crate::acl::Role;
+use crate::test_support::{build_signing_test_app_state_with_sink, did_for_seed, sign_as};
+use base64::engine::general_purpose::{STANDARD, URL_SAFE_NO_PAD};
+use sha2::{Digest, Sha256};
+use std::sync::Arc;
+use tokio::sync::Mutex;
+use trust_tasks_rs::validate::ValidatedPayload;
+use vta_sdk::jws::JwsKey;
+use vta_sdk::keys::{KeyStatus, KeyType};
+use vta_sdk::protocols::audit_management::list::AuditLogEntry;
+use vti_common::acl::{AclEntry, Capability, store_acl_entry};
+
+const CTX: &str = "community";
+const JWS: &str = "https://trusttasks.org/spec/keys/sign-jws/0.1";
+const CSR: &str = "https://trusttasks.org/spec/keys/sign-csr/0.1";
+const SIGN: &str = "https://trusttasks.org/spec/keys/sign/0.1";
+const ERROR_TYPE_PREFIX: &str = "https://trusttasks.org/spec/trust-task-error/";
+
+/// The verifier key the specification's examples name.
+const JWS_KEY: &str = "verifier-p256";
+/// The access-certificate key the specification's examples name.
+const CSR_KEY: &str = "eudi-access-p256";
+
+/// Test-only caller seeds (the private key is `[seed; 32]`).
+const PRODUCER_SEED: u8 = 0x71;
+
+#[derive(Default)]
+struct Rows(Mutex<Vec<AuditLogEntry>>);
+
+#[async_trait::async_trait]
+impl vta_audit::AuditSink for Rows {
+    async fn record(&self, entry: &AuditLogEntry) -> Result<(), crate::error::AppError> {
+        self.0.lock().await.push(entry.clone());
+        Ok(())
+    }
+}
+
+struct Fixture {
+    state: AppState,
+    _dir: tempfile::TempDir,
+    rows: Arc<Rows>,
+}
+
+impl Fixture {
+    /// A VTA with a `community` context holding a P-256 key for each task, an
+    /// Ed25519 key, and two key types neither task signs with.
+    async fn new() -> Self {
+        let rows = Arc::new(Rows::default());
+        let (state, dir) = build_signing_test_app_state_with_sink(Some(rows.clone())).await;
+        crate::contexts::create_context(&state.contexts_ks, CTX, CTX)
+            .await
+            .expect("create context");
+        let f = Self {
+            state,
+            _dir: dir,
+            rows,
+        };
+        f.mint(JWS_KEY, KeyType::P256).await;
+        f.mint(CSR_KEY, KeyType::P256).await;
+        f.mint("verifier-ed25519", KeyType::Ed25519).await;
+        f.mint("agreement-x25519", KeyType::X25519).await;
+        f.mint("pq-mldsa44", KeyType::MlDsa44).await;
+        f
+    }
+
+    async fn mint(&self, key_id: &str, key_type: KeyType) {
+        operations::keys::create_key(
+            &self.state.keys_ks,
+            &self.state.internal_ks,
+            &self.state.contexts_ks,
+            &self.state.seed_store,
+            &self.state.audit_sink,
+            &self.state.acl_ks,
+            &crate::test_support::super_admin_claims(),
+            operations::keys::CreateKeyParams {
+                internal: false,
+                key_type,
+                derivation_path: None,
+                key_id: Some(key_id.to_string()),
+                mnemonic: None,
+                label: None,
+                context_id: Some(CTX.to_string()),
+            },
+            "test",
+        )
+        .await
+        .unwrap_or_else(|e| panic!("mint {key_id}: {e:?}"));
+    }
+
+    async fn record(&self, key_id: &str) -> vta_sdk::keys::KeyRecord {
+        self.state
+            .keys_ks
+            .get(crate::keys::store_key(key_id))
+            .await
+            .unwrap()
+            .expect("key record")
+    }
+
+    async fn public(&self, key_id: &str) -> JwsKey {
+        JwsKey::from_did_key(&format!("did:key:{}", self.record(key_id).await.public_key))
+            .expect("a did:key")
+    }
+
+    /// The producer, an application of `CTX`, with an ACL entry narrowed to
+    /// `capabilities`.
+    async fn producer(&self, seed: u8, role: Role, capabilities: Vec<Capability>) -> AuthClaims {
+        let (did, _) = did_for_seed(seed);
+        store_acl_entry(
+            &self.state.acl_ks,
+            &AclEntry::new(&did, role.clone(), "did:key:zRoot")
+                .with_contexts(vec![CTX.to_string()])
+                .with_capabilities(capabilities),
+        )
+        .await
+        .expect("store the producer's entry");
+        AuthClaims {
+            did,
+            role,
+            allowed_contexts: vec![CTX.to_string()],
+            session_id: "test-session".into(),
+            ..Default::default()
+        }
+    }
+
+    /// Send `payload` as a signed `task` document from `seed` through the
+    /// dispatch spine, and return (request document, response document, the
+    /// `keys.sign*` audit rows this exchange added).
+    async fn send(
+        &self,
+        case: &str,
+        seed: u8,
+        auth: &AuthClaims,
+        task: &str,
+        payload: Value,
+    ) -> (Value, Value, Vec<AuditLogEntry>) {
+        let before = self.rows.0.lock().await.len();
+        let vta_did = self
+            .state
+            .config
+            .read()
+            .await
+            .vta_did
+            .clone()
+            .expect("vta_did");
+        let mut doc: TrustTask<Value> = serde_json::from_value(serde_json::json!({
+            "id": format!("urn:uuid:{}", uuid::Uuid::new_v4()),
+            "type": task,
+            "issuer": auth.did,
+            "recipient": vta_did,
+            "issuedAt": chrono::Utc::now().to_rfc3339_opts(chrono::SecondsFormat::Secs, true),
+            "payload": payload,
+        }))
+        .expect("a Trust Task document");
+        sign_as(seed, &mut doc);
+        let request = serde_json::to_value(&doc).unwrap();
+        let out = super::super::dispatch_trust_task_core(
+            &self.state,
+            auth,
+            &serde_json::to_vec(&doc).unwrap(),
+            super::super::transport::TransportConfidentiality::EndToEnd,
+        )
+        .await;
+        let response: Value = serde_json::from_slice(&out.body).expect("a JSON document");
+        let audit: Vec<AuditLogEntry> = self.rows.0.lock().await[before..]
+            .iter()
+            .filter(|r| r.action.starts_with("keys.sign"))
+            .cloned()
+            .collect();
+        evidence(case, &request, &response, &audit);
+        (request, response, audit)
+    }
+}
+
+/// Write one exchange to `VTI_EVIDENCE_DIR`, when it is set.
+fn evidence(case: &str, request: &Value, response: &Value, audit: &[AuditLogEntry]) {
+    let Some(dir) = std::env::var_os("VTI_EVIDENCE_DIR") else {
+        return;
+    };
+    let dir = std::path::PathBuf::from(dir);
+    std::fs::create_dir_all(&dir).expect("evidence dir");
+    let write = |suffix: &str, v: &Value| {
+        std::fs::write(
+            dir.join(format!("{case}.{suffix}.json")),
+            serde_json::to_string_pretty(v).unwrap() + "\n",
+        )
+        .expect("write evidence");
+    };
+    write("request", request);
+    write("response", response);
+    write(
+        "audit",
+        &serde_json::to_value(audit).expect("audit rows serialise"),
+    );
+}
+
+fn is_error(resp: &Value) -> bool {
+    resp["type"]
+        .as_str()
+        .is_some_and(|t| t.starts_with(ERROR_TYPE_PREFIX))
+}
+
+fn code(resp: &Value) -> &str {
+    resp.pointer("/payload/code")
+        .and_then(Value::as_str)
+        .unwrap_or_default()
+}
+
+/// A refusal: a `trust-task-error` with `code`, answering the request, with
+/// neither a JWS nor a CSR in it, and no signing row in the audit trail.
+fn assert_refused(case: &str, req: &Value, resp: &Value, audit: &[AuditLogEntry], want: &str) {
+    assert!(is_error(resp), "{case}: not a trust-task-error: {resp:#}");
+    assert_eq!(code(resp), want, "{case}: {resp:#}");
+    assert_eq!(
+        resp.pointer("/payload/inResponseTo/id"),
+        req.get("id"),
+        "{case}: answers the request"
+    );
+    assert!(
+        resp.pointer("/payload/jws").is_none() && resp.pointer("/payload/csr").is_none(),
+        "{case}: a refusal carries no signature: {resp:#}"
+    );
+    assert!(audit.is_empty(), "{case}: nothing was signed: {audit:?}");
+}
+
+/// The specification's example request (`keys/sign-jws/0.1`, "An OpenID4VP
+/// request object, signed with a P-256 key").
+fn spec_jws_request() -> Value {
+    serde_json::json!({
+        "keyId": JWS_KEY,
+        "header": {
+            "typ": "oauth-authz-req+jwt",
+            "kid": "did:example:community-verifier#key-1"
+        },
+        "payload": {
+            "aud": "https://self-issued.me/v2",
+            "client_id": "decentralized_identifier:did:example:community-verifier",
+            "response_type": "vp_token",
+            "response_mode": "direct_post.jwt",
+            "response_uri": "https://community.example/v1/oid4vp/response/7d1e4c2a",
+            "nonce": "q8vTt3yN5mQ0aW2f",
+            "state": "7d1e4c2a",
+            "dcql_query": {
+                "credentials": [{
+                    "id": "membership",
+                    "format": "dc+sd-jwt",
+                    "meta": { "vct_values": ["https://credentials.example/membership"] }
+                }]
+            },
+            "iat": 1791709200,
+            "exp": 1791709500

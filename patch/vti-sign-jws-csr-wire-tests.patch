+}
+
+/// The specification's example JWS; its first two segments are fixed by the
+/// request, its third is randomised (ECDSA).
+const SPEC_JWS: &str = "eyJhbGciOiJFUzI1NiIsImtpZCI6ImRpZDpleGFtcGxlOmNvbW11bml0eS12ZXJpZmllciNrZXktMSIsInR5cCI6Im9hdXRoLWF1dGh6LXJlcStqd3QifQ..9w2it71b0W3qKXW-vPPTvwCxJo7tGZgH5Fqn9oSFJMgaaYKlt3GS1GQAbXKfOYl51eZ3a8FJzoRwXctc4oiUvg";
+const SPEC_JWS_KEY: &str = "did:key:zDnaeTZCJom8WYgWfqp7ubMUwHK9ayrv31SSBJACRDDFiazq7";
+const SPEC_JWS_DIGEST: &str = "e0c236e3a90999a1ab54699f308c0ad0468405da185731762396cd733e031257";
+
+/// The specification's example request (`keys/sign-csr/0.1`, "A request for an
+/// EUDI relying-party access certificate").
+fn spec_csr_request() -> Value {
+    serde_json::json!({
+        "keyId": CSR_KEY,
+        "subject": [

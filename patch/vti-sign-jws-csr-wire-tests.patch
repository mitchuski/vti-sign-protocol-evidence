+  {
+    "note": "Empty `subject` — an empty distinguished name would make the subject alternative name the only identity, which RFC 5280 handles with a critical extension this task never requests.",
+    "payload": {
+      "keyId": "eudi-access-p256",
+      "subject": []
+    }
+  },
+  {
+    "note": "`subject` as a DN string — the custodian never parses a distinguished name; the structured attribute list is what lets it encode exactly what was asked.",
+    "payload": {

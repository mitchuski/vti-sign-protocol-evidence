+/// Conformance item 6: a registered member of the wrong type, and an `x5c`
+/// that is not a certificate for the named key, are `keys:invalidArgument`.
+#[tokio::test]
+async fn sign_jws_unusable_registered_members_are_invalid_arguments() {
+    let f = Fixture::new().await;
+    let auth = f
+        .producer(PRODUCER_SEED, Role::Application, vec![Capability::SignJws])
+        .await;
+    for (name, header) in [
+        ("typ-not-string", serde_json::json!({ "typ": 1 })),
+        ("kid-not-string", serde_json::json!({ "kid": ["a"] })),
+        (
+            "x5t-not-base64url",
+            serde_json::json!({ "x5t": "not base64url!" }),
+        ),
+        (
+            "x5c-not-a-certificate",
+            serde_json::json!({ "x5c": [STANDARD.encode(b"not a certificate")] }),
+        ),
+    ] {
+        let mut payload = spec_jws_request();
+        payload["header"] = header;
+        let case = format!("sign-jws-invalidArgument-{name}-refused");
+        let (req, resp, audit) = f.send(&case, PRODUCER_SEED, &auth, JWS, payload).await;
+        assert_refused(&case, &req, &resp, &audit, "keys:invalidArgument");
+    }
+}

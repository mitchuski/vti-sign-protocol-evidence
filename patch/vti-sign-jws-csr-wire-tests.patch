+      "subjectAltNames": { "ip": ["192.0.2.1"] }
+    }
+  },
+  {
+    "note": "An empty `subjectAltNames` object — present means at least one name; absent means none.",
+    "payload": {
+      "keyId": "eudi-access-p256",
+      "subject": [{ "type": "CN", "value": "Example Community Verifier" }],
+      "subjectAltNames": {}

+    "note": "An attribute type outside the closed set (passing an OID through) — each type's encoding is fixed by the specification, so an unknown one cannot be encoded on trust.",
+    "payload": {
+      "keyId": "eudi-access-p256",
+      "subject": [{ "type": "2.5.4.12", "value": "Verifier" }]
+    }
+  },
+  {
+    "note": "A lower-cased attribute short name — these are externally owned names carried verbatim (`CN`, not `cn`).",
+    "payload": {
+      "keyId": "eudi-access-p256",
+      "subject": [{ "type": "cn", "value": "Example Community Verifier" }]
+    }
+  },
+  {
+    "note": "An attribute with an empty value — X.520 attribute values are never empty.",
+    "payload": {
+      "keyId": "eudi-access-p256",
+      "subject": [{ "type": "CN", "value": "" }]
+    }
+  },
+  {
+    "note": "A multi-valued RDN smuggled as an extra member — each element is one single-valued RDN.",
+    "payload": {
+      "keyId": "eudi-access-p256",
+      "subject": [{ "type": "CN", "value": "Example Community Verifier", "also": { "type": "O", "value": "Example Community e.V." } }]
+    }
